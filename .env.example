# Telegram Bot Token (from @BotFather)
API_TOKEN=your_bot_token_here

# Telegram API credentials (from my.telegram.org)
# Required for uploading large files (>50MB)
API_ID=12345678
API_HASH=your_api_hash_here

# Database path (optional, default: data/bot.db)
# DB_PATH=/app/data/bot.db

# YouTube cookies file path (optional, default: data/youtube_cookies.txt)
# Needed when YouTube requires authentication
# See: https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
# COOKIES_PATH=data/youtube_cookies.txt

# YouTube cookies content (base64 encoded) - for deployment on servers
#
# HOW TO GET COOKIES:
#
# Method 1 - Cookie-Editor extension (RECOMMENDED):
#   Install from Chrome Web Store → Go to youtube.com → Click extension →
#   Export → Select "Netscape HTTP Cookie File" format
#
# Method 2 - yt-dlp:
#   pip install yt-dlp
#   yt-dlp --cookies-from-browser chrome --list-extractors
#
# Method 3 - Firefox cookies.txt extension
#
# ENCODE FOR ENV VARIABLE:
#   Linux/Mac: base64 -w 0 youtube_cookies.txt
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("youtube_cookies.txt"))
#
# YOUTUBE_COOKIES_CONTENT=your_base64_encoded_cookies_here


# ---- Queue & limits ----
# ADMIN_IDS=177036997            # comma-separated, admins have no limits
# MAX_CONCURRENT_DOWNLOADS=2     # downloads running at the same time
# MAX_QUEUE_SIZE=50              # max waiting jobs in total
# MAX_JOBS_PER_USER=2            # running + waiting jobs per user
# DAILY_LIMIT_PER_USER=30        # successful downloads per 24h (0 = unlimited)
# COOLDOWN_SECONDS=5             # min pause between links from one user

# ---- YouTube PO Token provider (bgutil) ----
# Set automatically in docker-compose. For other setups run the
# brainicism/bgutil-ytdlp-pot-provider container and point to it:
# POT_PROVIDER_URL=http://127.0.0.1:4416
# YTDLP_AUTO_UPDATE=1            # update yt-dlp on container start
